import SwiftUI

// MARK: - 登录

struct LoginView: View {
    @EnvironmentObject var store: CpeStore
    @State private var host = Settings.load().host
    @State private var user = Settings.load().user
    @State private var password = ""
    @State private var showPassword = false
    @State private var busy = false
    @State private var remember = true
    @State private var autoLogin = true
    @State private var showLog = false
    @FocusState private var focus: Field?

    private enum Field { case host, user, pass }

    var body: some View {
        NavigationStack {
            ZStack {
                // 浅色渐变背景
                LinearGradient(
                    colors: [
                        Color(red: 0.93, green: 0.95, blue: 1.0),
                        Color(red: 0.96, green: 0.97, blue: 1.0),
                        Color(red: 0.94, green: 0.96, blue: 1.0)
                    ],
                    startPoint: .top,
                    endPoint: .bottom
                )
                .ignoresSafeArea()

                ScrollView {
                    VStack(spacing: 0) {
                        Spacer().frame(height: 56)

                        // App 图标
                        appIcon

                        // 标题
                        Text("FiberHome Manager")
                            .font(.system(size: 30, weight: .heavy))
                            .foregroundStyle(Color(white: 0.08))
                            .padding(.top, 18)

                        Text("Fiberhome · 5G CPE 工程控制台")
                            .font(.system(size: 13.5))
                            .foregroundStyle(Color(white: 0.58))
                            .padding(.top, 6)

                        // 错误提示
                        if let err = store.errorText, !err.isEmpty {
                            errorBanner(err)
                                .padding(.top, 20)
                        }

                        // 表单卡片
                        formCard
                            .padding(.top, 26)

                        // 底部说明
                        Text("登录后会自动进入开发者模式，锁频段 / 锁小区 / AT 指令才可用。")
                            .font(.system(size: 11.5))
                            .foregroundStyle(Color(white: 0.6))
                            .multilineTextAlignment(.center)
                            .padding(.horizontal, 40)
                            .padding(.top, 18)

                        // 日志
                        logSection
                            .padding(.top, 24)

                        Spacer().frame(height: 30)
                    }
                }
                .scrollDismissesKeyboard(.interactively)
            }
            .navigationBarHidden(true)
        }
    }

    // MARK: - 图标

    private var appIcon: some View {
        ZStack {
            RoundedRectangle(cornerRadius: 30, style: .continuous)
                .fill(
                    LinearGradient(
                        colors: [
                            Color(red: 0.55, green: 0.63, blue: 1.0),
                            Color(red: 0.52, green: 0.50, blue: 0.95)
                        ],
                        startPoint: .topLeading,
                        endPoint: .bottomTrailing
                    )
                )
                .frame(width: 108, height: 108)
                .shadow(color: Color(red: 0.5, green: 0.55, blue: 0.95).opacity(0.35),
                        radius: 18, x: 0, y: 8)

            Text("F")
                .font(.system(size: 54, weight: .bold, design: .rounded))
                .foregroundStyle(.white)
        }
    }

    // MARK: - 表单卡片

    private var formCard: some View {
        VStack(spacing: 14) {
            // 路由器
            inputRow(icon: nil, label: "路由器", text: $host,
                     placeholder: "192.168.8.1", field: .host,
                     keyboard: .URL)

            // 账号
            inputRow(icon: nil, label: "账号", text: $user,
                     placeholder: "superadmin", field: .user)

            // 密码
            HStack(spacing: 10) {
                Text("密码")
                    .font(.system(size: 15))
                    .foregroundStyle(Color(white: 0.5))
                    .frame(width: 52, alignment: .leading)

                Group {
                    if showPassword {
                        TextField("请输入密码", text: $password)
                    } else {
                        SecureField("请输入密码", text: $password)
                    }
                }
                .font(.system(size: 16))
                .textInputAutocapitalization(.never)
                .autocorrectionDisabled()
                .focused($focus, equals: .pass)

                Button {
                    showPassword.toggle()
                } label: {
                    Image(systemName: showPassword ? "eye.slash" : "eye")
                        .font(.system(size: 15))
                        .foregroundStyle(Color(white: 0.6))
                }
            }
            .padding(.horizontal, 16)
            .frame(height: 56)
            .background(fieldBackground)

            // 开关
            VStack(spacing: 0) {
                switchRow("记住密码", isOn: $remember)
                switchRow("自动登录", isOn: $autoLogin)
            }
            .padding(.top, 2)

            // 连接按钮
            Button {
                Task { await doLogin() }
            } label: {
                HStack(spacing: 8) {
                    if busy {
                        ProgressView()
                            .tint(Color(white: 0.25))
                    }
                    Text(busy ? "正在连接…" : "连接路由器")
                        .font(.system(size: 16.5, weight: .semibold))
                        .foregroundStyle(Color(white: 0.15))
                }
                .frame(maxWidth: .infinity)
                .frame(height: 54)
                .background(
                    RoundedRectangle(cornerRadius: 27, style: .continuous)
                        .fill(Color.white.opacity(0.75))
                )
                .overlay(
                    RoundedRectangle(cornerRadius: 27, style: .continuous)
                        .strokeBorder(Color(white: 0.85), lineWidth: 1)
                )
            }
            .disabled(busy)
            .padding(.top, 8)
        }
        .padding(18)
        .background(
            RoundedRectangle(cornerRadius: 26, style: .continuous)
                .fill(Color.white.opacity(0.55))
        )
        .overlay(
            RoundedRectangle(cornerRadius: 26, style: .continuous)
                .strokeBorder(Color.white.opacity(0.9), lineWidth: 1.2)
        )
        .shadow(color: Color(red: 0.6, green: 0.67, blue: 0.95).opacity(0.12),
                radius: 24, x: 0, y: 10)
        .padding(.horizontal, 20)
    }

    private var fieldBackground: some View {
        RoundedRectangle(cornerRadius: 16, style: .continuous)
            .fill(Color.white.opacity(0.72))
    }

    private func inputRow(icon: String?, label: String, text: Binding<String>,
                          placeholder: String, field: Field,
                          keyboard: UIKeyboardType = .default) -> some View {
        HStack(spacing: 10) {
            Text(label)
                .font(.system(size: 15))
                .foregroundStyle(Color(white: 0.5))
                .frame(width: 52, alignment: .leading)

            TextField(placeholder, text: text)
                .font(.system(size: 16))
                .keyboardType(keyboard)
                .textInputAutocapitalization(.never)
                .autocorrectionDisabled()
                .focused($focus, equals: field)
        }
        .padding(.horizontal, 16)
        .frame(height: 56)
        .background(fieldBackground)
    }

    private func switchRow(_ title: String, isOn: Binding<Bool>) -> some View {
        HStack {
            Text(title)
                .font(.system(size: 16))
                .foregroundStyle(Color(white: 0.15))
            Spacer()
            Toggle("", isOn: isOn)
                .labelsHidden()
                .tint(Color(red: 0.35, green: 0.78, blue: 0.42))
        }
        .padding(.horizontal, 6)
        .frame(height: 50)
    }

    private func errorBanner(_ msg: String) -> some View {
        HStack(alignment: .top, spacing: 8) {
            Image(systemName: "exclamationmark.triangle.fill")
                .font(.system(size: 13))
                .foregroundStyle(Color(red: 0.9, green: 0.3, blue: 0.3))
            Text(msg)
                .font(.system(size: 12.5))
                .foregroundStyle(Color(red: 0.8, green: 0.2, blue: 0.2))
                .fixedSize(horizontal: false, vertical: true)
            Spacer(minLength: 0)
        }
        .padding(12)
        .background(
            RoundedRectangle(cornerRadius: 14, style: .continuous)
                .fill(Color(red: 1.0, green: 0.93, blue: 0.93))
        )
        .padding(.horizontal, 20)
    }

    // MARK: - 日志

    private var logSection: some View {
        VStack(alignment: .leading, spacing: 8) {
            Button {
                withAnimation(.easeInOut(duration: 0.2)) { showLog.toggle() }
            } label: {
                HStack(spacing: 5) {
                    Image(systemName: showLog ? "chevron.up" : "chevron.down")
                        .font(.system(size: 10, weight: .semibold))
                    Text("详细日志")
                        .font(.system(size: 12.5))
                }
                .foregroundStyle(Color(white: 0.45))
            }
            .padding(.leading, 24)

            if showLog {
                VStack(alignment: .leading, spacing: 4) {
                    if CpeNativeAPI.trace.isEmpty {
                        Text("暂无日志")
                            .foregroundStyle(Color(white: 0.6))
                    } else {
                        ForEach(Array(CpeNativeAPI.trace.enumerated()), id: \.offset) { _, line in
                            Text(line)
                                .foregroundStyle(Color(white: 0.35))
                        }
                    }
                }
                .font(.system(size: 10.5, design: .monospaced))
                .frame(maxWidth: .infinity, alignment: .leading)
                .padding(12)
                .background(
                    RoundedRectangle(cornerRadius: 12, style: .continuous)
                        .fill(Color.white.opacity(0.5))
                )
                .padding(.horizontal, 24)
            }

            // 诊断入口
            NavigationLink {
                DiagView().environmentObject(store)
            } label: {
                HStack(spacing: 5) {
                    Image(systemName: "stethoscope")
                        .font(.system(size: 11))
                    Text("连接诊断")
                        .font(.system(size: 12.5))
                }
                .foregroundStyle(Color(red: 0.35, green: 0.5, blue: 0.95))
            }
            .padding(.leading, 24)
        }
    }

    // MARK: - 登录

    private func doLogin() async {
        let h = host.trimmingCharacters(in: .whitespacesAndNewlines)
        let u = user.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !h.isEmpty else { store.errorText = "请填写路由器地址"; return }
        guard !u.isEmpty else { store.errorText = "请填写账号"; return }
        guard !password.isEmpty else { store.errorText = "请输入密码"; return }

        busy = true
        store.errorText = nil
        let ok = await store.login(host: h, user: u, password: password)
        busy = false
        if ok { store.startPolling() }
    }
}
